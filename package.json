{
	"name": "site",
	"private": true,
	"version": "0.0.1",
	"packageManager": "bun@1.3.10",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && wrangler types --check",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"preview": "wrangler dev --env preview",
		"check:worker-types": "wrangler types --check",
		"cf-typegen": "wrangler types",
		"test": "bun test",
		"prepare": "svelte-kit sync || echo ''",
		"check:head": "bun scripts/check-head.mjs --base http://localhost:5173"
	},
	"devDependencies": {
		"@internationalized/date": "^3.10.0",
		"@lucide/svelte": "^0.561.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"svelte-check": "^4.7.8",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.18",
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.6",
		"bits-ui": "^2.14.4",
		"clsx": "^2.1.1",
		"svelte": "^5.57.2",
		"tailwind-merge": "^3.4.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.0",
		"vite": "^8.0.12",
		"wrangler": "^4.67.0"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.103.2",
		"pdf-lib": "1.17.1",
		"zod": "^4.3.6"
	}
}
